{
  "uid": "nodeprobe",
  "title": "nodeprobe",
  "description": "Load, memory and disk metrics exposed by nodeprobe.",
  "tags": [
    "nodeprobe"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Load average",
      "description": "Tasks running or waiting for the CPU. Not a percentage.",
      "datasource": {
        "type": "prometheus",
        "uid": "nodeprobe-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_load1",
          "legendFormat": "1m"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_load5",
          "legendFormat": "5m"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_load15",
          "legendFormat": "15m"
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Memory used",
      "description": "100 * (1 - available / total), the share of RAM programs cannot get back.",
      "datasource": {
        "type": "prometheus",
        "uid": "nodeprobe-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "100 * (1 - nodeprobe_memory_available_bytes / nodeprobe_memory_total_bytes)",
          "instant": true,
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Disk used (/)",
      "description": "used / (used + available), the same ratio df reports as Use%. The root reserve is excluded.",
      "datasource": {
        "type": "prometheus",
        "uid": "nodeprobe-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "100 * nodeprobe_disk_used_bytes / (nodeprobe_disk_used_bytes + nodeprobe_disk_available_bytes)",
          "instant": true,
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Memory",
      "description": "total - available is what is really taken; free excludes the reclaimable page cache.",
      "datasource": {
        "type": "prometheus",
        "uid": "nodeprobe-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_memory_total_bytes - nodeprobe_memory_available_bytes",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_memory_available_bytes",
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_memory_free_bytes",
          "legendFormat": "free"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_memory_total_bytes",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk (/)",
      "description": "used + available is smaller than total: ~5% is reserved for root.",
      "datasource": {
        "type": "prometheus",
        "uid": "nodeprobe-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_disk_used_bytes",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_disk_available_bytes",
          "legendFormat": "available"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_disk_free_bytes",
          "legendFormat": "free (incl. root reserve)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_disk_total_bytes",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Now",
      "datasource": {
        "type": "prometheus",
        "uid": "nodeprobe-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "exporter"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN",
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "UP",
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^(memory available|disk available)$"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "up{job=\"nodeprobe\"}",
          "instant": true,
          "legendFormat": "exporter"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_load1",
          "instant": true,
          "legendFormat": "load 1m"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_memory_available_bytes",
          "instant": true,
          "legendFormat": "memory available"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "nodeprobe-prom"
          },
          "expr": "nodeprobe_disk_available_bytes",
          "instant": true,
          "legendFormat": "disk available"
        }
      ]
    }
  ]
}
